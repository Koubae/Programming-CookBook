{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // ------------------------------------------------------------------------ \\
        //                                🐍 Python
        // ------------------------------------------------------------------------ \\
        {
            "name": "🐍 Run Python file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "🐍 Run Python file with arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        // ------------------------------------------------------------------------ \\
        //                                🚀 Go/Golang
        // ------------------------------------------------------------------------ \\
        {
            "name": "🚀 Run Go file",
            "type": "go",
            "request": "launch",
            "mode": "debug", // auto, debug, test, exec
            "program": "${file}",
            // If you want to accept stdin
            "console": "integratedTerminal",
            // "envFile": ".env",
        }
    ]
}